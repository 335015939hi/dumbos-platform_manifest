<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- ===== Remotes ===== -->
  <remote name="grapheneos"
          fetch="https://github.com/GrapheneOS/" />

  <remote name="aosp"
          fetch="https://android.googlesource.com/" />

  <remote name="silyos"
          fetch="git@github.com:SilyOS/" />

  <!-- ===== Default ===== -->
  <default
      revision="14"
      remote="grapheneos"
      sync-j="8" />

  <!-- ===== Core Android / GrapheneOS ===== -->
  <project name="platform_frameworks_base"
           path="frameworks/base"
           remote="grapheneos" />

  <project name="platform_system_core"
           path="system/core"
           remote="grapheneos" />

  <!-- ===== Device Pixel 5 (redfin) ===== -->
  <project name="device_google_redfin"
           path="device/google/redfin"
           remote="grapheneos" />

  <project name="kernel_google_redfin"
           path="kernel/google/redfin"
           remote="grapheneos" />

  <project name="vendor_google_redfin"
           path="vendor/google/redfin"
           remote="grapheneos" />

  <!-- ===== SilyOS Branding (CUSTOM) ===== -->
  <project name="branding"
           path="vendor/silyos/branding"
           remote="silyos" />

</manifest>
